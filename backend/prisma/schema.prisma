// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // AÑADIMOS la ruta de salida.
  // Esta ruta (relativa a este fichero) apunta a 'node_modules'
  // y es donde 'server.ts' buscará el cliente.
 
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
// --- MODELO 1: LAS OBRAS / VIVIENDAS ---
model Vivienda {
  id                 Int      @id @default(autoincrement())
  nombre             String
  ciudad             String
  provinciaEstado    String   @map("provincia_estado")
  fotoPrincipalUrl   String   @map("foto_principal_url")
  inmobiliariaNombre String?  @map("inmobiliaria_nombre")
  inmobiliariaUrl    String?  @map("inmobiliaria_url")
  precioMinimo       String
  resumen            String   @db.Text
  mapLink            String?  @db.Text // URL de Google Maps
  renderLink         String?  @db.Text // URL de Matterport
  latitud            Float?
  longitud           Float?
  createdAt          DateTime @default(now())

  // --- Relaciones ---
  unidades    Unidad[]
  galeria     ImagenGaleria[]
  solicitudes SolicitudInfo[]
  documentos  DocumentoDescargable[] @relation("ViviendaToDocumentos")
  socialLinks SocialMediaLink[] // <-- NUEVA RELACIÓN

  @@map("viviendas")
}

// --- MODELO 2: UNIDADES DE LA TABLA ---
model Unidad {
  id          Int      @id @default(autoincrement())
  viviendaRef String   @map("vivienda_ref")
  m2          Float
  terrazas    String?
  precio      String
  planoPdfUrl String?  @map("plano_pdf_url")
  createdAt   DateTime @default(now())

  vivienda    Vivienda @relation(fields: [viviendaId], references: [id], onDelete: Cascade)
  viviendaId  Int      @map("vivienda_id")

  @@map("unidades")
}

// --- MODELO 3: GALERÍA DE IMÁGENES ---
model ImagenGaleria {
  id         Int      @id @default(autoincrement())
  url        String   @db.Text // Usar Text por si la URL es muy larga
  createdAt  DateTime @default(now())

  vivienda   Vivienda @relation(fields: [viviendaId], references: [id], onDelete: Cascade)
  viviendaId Int      @map("vivienda_id")

  @@map("imagenes_galeria")
}

// --- MODELO 4: SOLICITUDES DE INFORMACIÓN ---
model SolicitudInfo {
  id         Int      @id @default(autoincrement())
  nombre     String
  email      String
  telefono   String?
  createdAt  DateTime @default(now())

  vivienda   Vivienda @relation(fields: [viviendaId], references: [id])
  viviendaId Int      @map("vivienda_id")

  @@map("solicitudes_info")
}

// --- MODELO 5: SUSCRIPCIONES ---
model Suscripcion {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("suscripciones")
}

// --- MODELO 6: DOCUMENTOS DESCARGABLES ---
model DocumentoDescargable {
  id           Int      @id @default(autoincrement())
  nombreBoton  String   @map("nombre_boton")
  rutaArchivo  String   @map("ruta_archivo") @db.Text
  createdAt    DateTime @default(now())

  vivienda     Vivienda @relation("ViviendaToDocumentos", fields: [viviendaId], references: [id], onDelete: Cascade)
  viviendaId   Int      @map("vivienda_id") 

  @@map("documentos_descargables")
}

// --- MODELO 7: REDES SOCIALES (¡NUEVO!) ---
model SocialMediaLink {
  id          Int      @id @default(autoincrement())
  plataforma  String   // Ej: "Instagram", "TikTok"
  url         String   @db.Text
  createdAt   DateTime @default(now())

  vivienda    Vivienda @relation(fields: [viviendaId], references: [id], onDelete: Cascade)
  viviendaId  Int      @map("vivienda_id")

  @@map("social_media_links")
}