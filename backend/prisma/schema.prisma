// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
// --- MODELO 1: HOUSING LOCATION (Coincide con HousingLocationInfo) ---
model HousingLocation {
  id              Int      @id @default(autoincrement())
  name            String
  city            String
  state           String
  photo           String   @db.Text
  realEstateName  String?  
  realEstateLink  String?  @db.Text
  minimunPrice    String
  resume          String   @db.Text
  renderLink      String?  @db.Text
  mapLink         String?  @db.Text
  lat             Float?
  lng             Float?
  createdAt       DateTime @default(now())

  // Relaciones (Arrays en tu interfaz)
  units             Unit[]
  downloadDocuments DownloadDocument[]
  socialMediaLinks  SocialMediaLink[]
  galleryImages     GalleryImage[] 
  solicitudes       SolicitudInfo[] // Interno para el backend

  @@map("housing_locations")
}

// --- MODELO 2: UNIT (Coincide con Unit) ---
model Unit {
  id          Int     @id @default(autoincrement())
  vivienda    String  // Antes 'viviendaRef'. Coincide con tu interfaz.
  m2          Float
  terrazas    String? 
  precio      String  
  planoPdfUrl String? @db.Text
  dormitorios Int?     // Número de habitaciones
  banos       Int?     // Número de baños
  precioConIva String? @map("precio_con_iva") // Opcional, calculado

  // Relación con HousingLocation
  housingLocation   HousingLocation @relation(fields: [housingLocationId], references: [id], onDelete: Cascade)
  housingLocationId Int

  @@map("units")
}

// --- MODELO 3: SOCIAL MEDIA LINK (Coincide con SocialMediaLink) ---
model SocialMediaLink {
  id              Int    @id @default(autoincrement())
  nombreRedSocial String // Antes 'plataforma'
  rutaArchivo     String @db.Text // Antes 'url'

  // Relación
  housingLocation   HousingLocation @relation(fields: [housingLocationId], references: [id], onDelete: Cascade)
  housingLocationId Int

  @@map("social_media_links")
}

// --- MODELO 4: DOWNLOAD DOCUMENT (Coincide con DownloadDocument) ---
model DownloadDocument {
  id          Int    @id @default(autoincrement())
  nombreBoton String
  rutaArchivo String @db.Text

  // Relación
  housingLocation   HousingLocation @relation(fields: [housingLocationId], references: [id], onDelete: Cascade)
  housingLocationId Int

  @@map("download_documents")
}

// --- MODELO 5: GALLERY IMAGES (Para galleryImages: string[]) ---
// Nota: Como en la BD debe ser una tabla, usaremos el campo 'url' para mapearlo luego a string[]
model GalleryImage {
  id  Int    @id @default(autoincrement())
  url String @db.Text

  // Relación
  housingLocation   HousingLocation @relation(fields: [housingLocationId], references: [id], onDelete: Cascade)
  housingLocationId Int

  @@map("gallery_images")
}

// --- MODELO 6: SOLICITUDES INFO (Formulario) ---
model SolicitudInfo {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String
  telefono  String?
  createdAt DateTime @default(now())

  housingLocation   HousingLocation @relation(fields: [housingLocationId], references: [id])
  housingLocationId Int

  @@map("solicitudes_info")
}

// --- MODELO 7: SUSCRIPCIONES (Footer) ---
model Suscripcion {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("suscripciones")
}