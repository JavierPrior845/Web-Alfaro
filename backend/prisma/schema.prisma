// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
// --- MODELO 1: COLAB (Coincide con ColabsLocationInfo) ---
model Colab {
  id               Int     @id @default(autoincrement())
  name             String
  logo             String  @db.Text
  website          String  @db.Text
  description      String  @db.Text
  address          String
  phone            String
  email            String

  // Relaciones
  socialMediaLinks SocialMediaLink[]
  housingLocations HousingLocation[] // Una inmobiliaria tiene muchas promociones

  @@map("colabs")
}

// --- MODELO 2: SOCIAL MEDIA LINK (Ahora pertenece a Colab) ---
model SocialMediaLink {
  id              Int    @id @default(autoincrement())
  nombreRedSocial String
  rutaArchivo     String @db.Text

  // Relación con Colab
  colab   Colab @relation(fields: [colabId], references: [id], onDelete: Cascade)
  colabId Int

  @@map("social_media_links")
}

// --- MODELO 3: HOUSING LOCATION (Coincide con HousingLocationInfo) ---
model HousingLocation {
  id         Int     @id @default(autoincrement())
  estado     String  // 'venta', 'proyecto', etc.
  name       String
  city       String
  state      String  // Barrio/Zona
  photo      String  @db.Text
  resume     String  @db.Text
  renderLink String? @db.Text
  mapLink    String? @db.Text
  
  // Relación con Colab (Inmobiliaria)
  // En tus datos se llama 'realEstateId'
  realEstate   Colab? @relation(fields: [realEstateId], references: [id])
  realEstateId Int?

  // Relaciones (Arrays)
  units             Unit[]
  downloadDocuments DownloadDocument[]
  galleryImages     GalleryImage[]
  
  createdAt  DateTime @default(now())

  @@map("housing_locations")
}

// --- MODELO 4: UNIT (Actualizado) ---
model Unit {
  id             Int     @id @default(autoincrement())
  
  // Nuevos campos según tu interfaz
  planta         String? // Ej: "1", "Bajo", "Ático"
  tipologia      String? // Ej: "A", "B", "Local" (Antes vivienda)
  dormitorios    String? // String para soportar números y guiones
  banos          String? 
  piscina        String? // Ej: "Sí", "No", "Comunitaria"
  
  m2construidos  String? // Antes m2
  m2utiles       String? // Nuevo campo
  m2terraza      String? // Antes terrazas
  
  orientacion    String? // Ej: "Norte", "Sur"
  eficEnergetica String? // Ej: "A", "B"
  garage         String? // Ej: "Incluido", "Opcional"
  trastero       String? // Ej: "Incluido"
  
  planoPdfUrl    String? @db.Text

  // Relación
  housingLocation   HousingLocation @relation(fields: [housingLocationId], references: [id], onDelete: Cascade)
  housingLocationId Int

  @@map("units")
}

// --- MODELO 5: DOWNLOAD DOCUMENT ---
model DownloadDocument {
  id          Int    @id @default(autoincrement())
  nombreBoton String
  rutaArchivo String @db.Text

  // Relación
  housingLocation   HousingLocation @relation(fields: [housingLocationId], references: [id], onDelete: Cascade)
  housingLocationId Int

  @@map("download_documents")
}

// --- MODELO 6: GALLERY IMAGES ---
// Nota: SQL no soporta arrays de strings simples. 
// Esto devolverá objetos { "url": "..." }. 
// En el frontend recibirás un array de objetos, no de strings, 
// a menos que hagas un map() en el backend.
model GalleryImage {
  id  Int    @id @default(autoincrement())
  url String @db.Text // Corresponde a los strings del array galleryImages

  // Relación
  housingLocation   HousingLocation @relation(fields: [housingLocationId], references: [id], onDelete: Cascade)
  housingLocationId Int

  @@map("gallery_images")
}

